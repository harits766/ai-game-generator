# Salin jadi .streamlit/secrets.toml (lokal) atau isi di Streamlit Cloud > App settings > Secrets.
# Semua opsional: tanpa key, app tetap jalan pakai mode offline.
GEMINI_API_KEY = ""          # gratis: https://aistudio.google.com/apikey
GEMINI_MODEL = "gemini-2.5-flash"
OPENAI_API_KEY = ""          # cadangan kalau kuota Gemini habis
OPENAI_MODEL = "gpt-4o-mini"
LLM_PROVIDER = "auto"        # auto | gemini | openai
APP_URL = ""                 # contoh: https://ai-game-generator.streamlit.app (kalau kosong dideteksi otomatis)
