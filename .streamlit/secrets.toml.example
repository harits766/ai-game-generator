# Salin jadi .streamlit/secrets.toml (lokal) atau isi di Streamlit Cloud > App settings > Secrets.
# Semua opsional: tanpa key, app tetap jalan (agent pakai planner offline, log hanya lokal).

# --- LLM (dipakai HANYA oleh: agent Game Master, chain konten soal, chain desainer game) ---
GEMINI_API_KEY = ""          # gratis: https://aistudio.google.com/apikey  (utama)
# GEMINI_MODEL = "gemini-2.5-flash"            # opsional
# GEMINI_FALLBACK_MODEL = "gemini-2.5-flash-lite"  # opsional, dipakai saat kuota model utama habis
GEMINI_MODEL = "gemini-2.5-flash"
OPENAI_API_KEY = ""          # cadangan otomatis kalau Gemini gagal/kuota habis
# OPENAI_DAILY_CALLS = 150   # batas panggilan OpenAI per hari (~USD 0,1-0,2/hari maks dengan gpt-4o-mini)
OPENAI_MODEL = "gpt-4o-mini"
LLM_PROVIDER = "auto"        # auto | gemini | openai

# --- Penyimpanan permanen log request in-app (branch `data` di repo ini) ---
GITHUB_TOKEN = ""            # fine-grained token: repo ini saja, izin Contents = Read and write
GITHUB_REPO = "harits766/ai-game-generator"
DATA_BRANCH = "data"

APP_URL = ""                 # contoh: https://ai-game-generator.streamlit.app (kosong = deteksi otomatis)
